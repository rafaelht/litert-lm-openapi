# ==============================================================================
# LiteRT-LM OpenAPI Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Modo Thinking / Razonamiento
# ------------------------------------------------------------------------------
# false = Modo rápido directo (máxima velocidad, sin retrasos, respuesta en < 3-5s)
# true  = Permite razonamiento interno (más lento, genera tokens de pensamiento)
ENABLE_THINKING=false
THINKING_TOKEN_BUDGET=384

# ------------------------------------------------------------------------------
# 2. Rendimiento y CPU (Intel N100: 4 núcleos / 4 hilos)
# ------------------------------------------------------------------------------
CPU_THREADS=4

# ------------------------------------------------------------------------------
# 3. Ventana de Contexto y Rollover Continuo
# ------------------------------------------------------------------------------
MAX_NUM_TOKENS=4096
CONTEXT_ROLLOVER_THRESHOLD_TOKENS=3400
CONTEXT_ROLLOVER_RECENT_MESSAGES=4
CONTEXT_ROLLOVER_RECENT_TOKEN_BUDGET=1024

# ------------------------------------------------------------------------------
# 4. Gestión de Memoria y Sesiones
# ------------------------------------------------------------------------------
# Máximo de conversaciones concurrentes mantenidas en RAM
MAX_ACTIVE_CONVERSATIONS=5
SESSION_TIMEOUT=1800

# Desactivar caché en disco de XNNPACK para evitar inflar la memoria RSS
ENABLE_XNNPACK_CACHE=false

# 0 = Solo lenguaje (evita cargar 5.200 tensores de visión y audio en RAM)
MAX_NUM_IMAGES=0

# ------------------------------------------------------------------------------
# 5. Funciones Adicionales
# ------------------------------------------------------------------------------
# false = Generación instantánea (< 1ms) de títulos y etiquetas para OpenWebUI
ENABLE_ADMIN_LLM=false

# true = Permite llamadas a herramientas de OpenWebUI
ENABLE_TOOLS=true

# Desactivar benchmarking de C++
ENABLE_BENCHMARK=false

# ------------------------------------------------------------------------------
# 6. Red y Puertos
# ------------------------------------------------------------------------------
HOST_PORT=8005
SERVER_PORT=8000
MODEL_PATH=/models/gemma-4-E2B-it.litertlm/model.litertlm
MODEL_PROFILE=profiles/default.yaml
