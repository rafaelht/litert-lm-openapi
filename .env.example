MODEL_PATH=/models/gemma-4-E2B-it.litertlm/model.litertlm
SERVER_PORT=8000
HOST_PORT=8005

# Gestión de ciclo de vida y recursos para NAS (Intel N100 / 8 GB RAM)
ENGINE_TTL_SECONDS=0
MAX_CONCURRENT_GENERATIONS=1
MAX_ACTIVE_CONVERSATIONS=20
SESSION_TIMEOUT=1800
ENABLE_WARM_POOL=false

# Gestión de contexto (Gemma 4 E2B)
CONTEXT_ROLLOVER_THRESHOLD_TOKENS=4096
CONTEXT_ROLLOVER_RECENT_MESSAGES=2
CONTEXT_ROLLOVER_RECENT_TOKEN_BUDGET=512

# Capacidades y compatibilidad con OpenWebUI
ENABLE_THINKING=false
ENABLE_TOOL_CALLING=true
FILTER_THINKING_FROM_KV_CACHE=true
MAX_NUM_IMAGES=4

